      class="-translate-x-1/2 bg-primary duration-300 fixed left-1/2 max-w-[90vw] opacity-0 pointer-events-none px-4 py-2 rounded-full shadow-lg text-center text-white text-xs top-14 transition-all z-[70]"
      role="status"
    />
  </div>
</body>"
`;

