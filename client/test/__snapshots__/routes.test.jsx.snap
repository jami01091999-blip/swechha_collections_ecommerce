          >
            <div
              class="bg-outline-variant h-1 mb-3 md:hidden mx-auto rounded-full w-10"
            />
            <h2
              class="font-headline-sm text-headline-sm text-primary"
            >
              Delete Draft Linen Top?
            </h2>
            <p
              class="font-body-sm mt-1 text-body-sm text-on-surface-variant"
            >
              This removes it from the catalogue and deletes its uploaded photos. This cannot be undone.
            </p>
            <div
              class="gap-2.5 grid grid-cols-2 mt-5"
            >
              <button
                class="active:scale-95 border border-[#C59B6A] font-label-lg py-3 rounded-xl text-label-lg text-on-surface transition-all"
                type="button"
              >
                Cancel
              </button>
              <button
                class="active:scale-95 bg-error disabled:opacity-60 font-label-lg py-3 rounded-xl text-label-lg text-white transition-all"
                type="button"
              >
                Delete
              </button>
            </div>
          </div>
        </div>
      </div>
