{
  "name": "swechha-collections",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"npm run dev -w server\" \"npm run dev -w client\"",
    "dev:web": "npm run dev -w client",
    "dev:api": "npm run dev -w server",
    "build": "npm run build -w client",
    "start": "npm start -w server",
    "test": "npm test -w server && npm test -w client",
    "seed": "npm run seed -w server",
    "seed:reset": "npm run seed:reset -w server",
    "db:indexes": "npm run db:indexes -w server",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "concurrently": "^9.1.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "prettier": "^3.9.9"
  }
}
