{
  "name": "swechha-collections",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": { "node": ">=20" },
  "workspaces": ["client", "server"],
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"node dev-server.js\" \"npm run dev -w client\"",
    "dev:web": "npm run dev -w client",
    "dev:api": "node dev-server.js",
    "build": "npm run build -w client",
    "seed": "node scripts/seed.js",
    "seed:reset": "node scripts/seed.js --reset"
  },
  "dependencies": {
    "mongodb": "^6.10.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.1"
  }
}
