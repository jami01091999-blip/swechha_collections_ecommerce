# Copy to server/.env for local development. On Render, set these in the dashboard.
NODE_ENV=development
PORT=4000
# test = codes are also printed in the server log and email is optional; live = real email required (Phase 8)
APP_MODE=test
LOG_LEVEL=info

# Comma-separated list of sites allowed to call the API from a browser
CLIENT_ORIGIN=http://localhost:5173

# MongoDB Atlas
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/swechha?retryWrites=true&w=majority
MONGO_DB=swechha

# Sign-in. Two different random secrets (at least 32 characters each), made with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
OTP_SECRET=
# Emails that become admins when they sign in (comma-separated)
ADMIN_EMAILS=you@example.com
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# Email for sign-in codes (Gmail: Google Account → Security → App passwords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=shop@gmail.com
SMTP_PASS=
MAIL_FROM=Swechha Collections <shop@gmail.com>

# Cloudinary (Dashboard → Settings → API Keys). Leave empty to disable photo uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=swechha/products

# Optional: number of proxies in front of the API (default 1 = Render's load balancer)
# TRUST_PROXY=1
